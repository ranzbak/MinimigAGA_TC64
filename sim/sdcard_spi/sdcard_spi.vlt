// Lint waivers for the sdcard_spi unit bench under Verilator (run.sh).
// Bench side only: rtl/host/sdcard_spi.v needs none.  Every other warning
// stops the build.  (Verilator 5.020 takes no comments after
// `verilator_config, so they are all up here.)
// 1-3  the bench: integers into 16-bit register writes, 32-bit sums;
//      non-blocking assignments in its tasks (the cfide-side drive)
// 4-5  SD card model (sim/common/sd_spi_model.v), as in sim/l3/l3.vlt:
//      32-bit integer arithmetic into narrower registers; miso written from
//      the sck and the cs_n edge blocks (a model, not synthesisable logic)
`verilator_config
lint_off -rule WIDTHEXPAND -file "*tb_sdcard_spi.v"
lint_off -rule WIDTHTRUNC  -file "*tb_sdcard_spi.v"
lint_off -rule INITIALDLY  -file "*tb_sdcard_spi.v"
lint_off -rule WIDTHTRUNC  -file "*sd_spi_model.v"
lint_off -rule MULTIDRIVEN -file "*sd_spi_model.v"
