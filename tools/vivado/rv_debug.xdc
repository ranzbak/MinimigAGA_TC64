# rv_debug.xdc -- the RISC-V debug module's JTAG clock.  LAB BUILDS ONLY.
#
# Read only by build_ap040.tcl with RV_DEBUG=1: tools/vivado/hostcpu.tcl
# (hostcpu_apply $R 1) adds it to the constraint set the runs use, XC7A100T,
# with PROCESSING_ORDER LATE -- after clocks.xdc, which names clk_114, and
# after wizard.xdc -- and takes it out again afterwards.  The shipping image
# (rv_debug = 0) never sees this file: without the BSCANE2 the get_pins below
# would find nothing.
#
# rv_tck: the BSCANE2 (USER4) TCK output in rtl/host/xilinx/rv_bscane2.v,
# instance openaars_virtual_top/hostcpu/myrv/g_core.u_bscan/u_bscane2
# (rtl/host/rv_hostcpu.v, DEBUG = 1).  It goes through the BUFG u_bufg_tck
# beside it and clocks the JTAG side of VexOsd_DMT's debug transport
# (DebugTransportModuleTunneled: the tunnel's shift/instruction registers, the
# dtmcs and dmi registers).  50 ns = 20 MHz, above the Platform Cable USB II's
# 12 MHz maximum (the cable's default is 6 MHz), so any TCK the cable can
# produce is covered.
create_clock -name rv_tck -period 50.000 [get_pins -hier -filter {NAME =~ *u_bscan/u_bscane2/TCK}]

# The host CPU's clock: the bridge (openaars_virtual_top/hostcpu, rtl/host/
# host_bridge.vhd, and rv_hostcpu/VexOsd_DMT inside it) runs on CLK_114
# (rtl/soc/minimig_virtual_top.v, hostcpu .clk(CLK_114)), which is
# clk_114 = openaars_virtual_top/amiga_clk/amiga_clk_i/clk_main/CLKOUT0,
# 8.815 ns (clocks.xdc; build B's clocks.rpt, build/stage_p5b_87577e2).
#
# rv_tck and clk_114 are unrelated clocks, and every path between them goes
# through the debug transport's own clock-domain crossing, generated by
# SpinalHDL into rtl/host/vexriscv/VexOsd_DMT.v, all of it under
# .../g_core.u_core/debugTransportModuleTunneled/:
#
#   rv_tck -> clk_114, the DMI command (logic_jtagLogic_dmiCmd_ccToggle,
#   module VexOsd_DMT_FlowCCByToggle): on rv_tck, inputArea_target toggles and
#   inputArea_data_write / _data / _address take the command; on clk_114 the
#   toggle passes the two-flop synchroniser inputArea_target_buffercc
#   (VexOsd_DMT_BufferCC, buffers_0 / buffers_1, ASYNC_REG) and is compared
#   with outputArea_hit; only then is the payload used.  The payload is held
#   until the next command, which needs a whole new DMI scan (40+ TCK cycles).
#
#   clk_114 -> rv_tck, the DMI response (logic_systemLogic_bus_rsp_ccToggle,
#   VexOsd_DMT_FlowCCByToggle_1): on clk_114, inputArea_target toggles and
#   inputArea_data_error / _data take the response; on rv_tck the toggle
#   passes inputArea_target_buffercc (VexOsd_DMT_BufferCC_2, buffers_0 /
#   buffers_1, ASYNC_REG) and outputArea_hit, then outputArea_flow_m2sPipe_
#   payload_error / _data (ASYNC_REG) capture the payload, which stays put
#   until the next command is answered.
#
#   clk_114 -> rv_tck, reset: debugReset asserts debugReset_asyncAssert
#   SyncDeassert_buffercc (VexOsd_DMT_BufferCC_1, buffers_0 / buffers_1)
#   asynchronously and its release is synchronised to rv_tck
#   (debugReset_synchronized resets the rv_tck side above).
#
# No combinational path crosses, every multi-bit value is sampled only after
# its toggle has been through two flops and is held stable far longer than
# that, so the crossing does not depend on a timed relation between the two
# clocks.  (The data skew is not bounded by a set_max_delay; at these clock
# ratios -- two clk_114 cycles = 17.6 ns of synchroniser against a payload
# that is stable for microseconds -- it does not matter.)  rv_debug.rpt
# (build_ap040.tcl) lists the report_cdc of both directions as the check.
#
# Only clk_114 is declared asynchronous to rv_tck: a path from rv_tck to any
# other clock would be unexpected and stays timed, so it shows up as a
# failing or unconstrained path instead of being hidden.
set_clock_groups -asynchronous -group [get_clocks rv_tck] -group [get_clocks clk_114]
