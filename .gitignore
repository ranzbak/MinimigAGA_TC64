# ignore backup files
*~

# ignore vi swapfiles
.*.swp

# ignore compiled python
*pyc

# ignore some backup files
*bak

# ignore some c files
*\.o
*\.d

# ignore dropbox files
.dropbox.attr

# ignore directories
bin/
rel/
fpga/*/out/
fpga/*/db/
fpga/*/incremental_db/
greybox_tmp/

# build script shouldn't be in repo
build.sh

# ignore generated version file
rtl/minimig/minimig_version.vh

# Ignore Vivado project
project_1/**

# Ignore the built Rom generator
fw/romgen/romgen
fw/ctrl_boot_832/OSDBoot_832.bin
fw/ctrl_boot_832/OSDBoot_832.map
fw/ctrl_832/832OSDAD.bin
fw/ctrl_832/832OSDAD.map

# Ignore Xvhdl files
xvhdl.*
.Xil/*

# Editor files
.hdl_checker/*
.vscode/*
vivado*
!tools/vivado/
fw/ctrl_832/*.asm
fw/ctrl_832/swoopBuf
xvlog.*
.library_mapping.xml
.log*
unisims
.dvt
.editorconfig
.project
.settings
*.wcfg
dvt_build.log
*.meta
# Simulation products (iverilog/vvp binaries, waveforms, run logs)
sim/**/build/
*.vvp
*.vcd
*.fst
*.lxt
*.lxt2

# Vivado / JVM byproducts outside the project directory
hs_err_pid*.log
*.jou
*.str
.Xil/
webtalk*
usage_statistics_webtalk*
sys_sync_rise_out.txt

# Sigasi project file
project.server.json

findings/**/*.rpt
findings/**/sim-logs/
# DDR3 bring-up VIO, generated by tools/vivado/build.tcl
ip/ddr3/

# Vivado stage outputs from tools/vivado/build*.tcl (bitstreams, probe files, reports)
/build/
/xelab.pb

# Simulation run directories and their logs (sim/*/run.sh with a RUNTAG)
sim/**/run_*/
sim/**/xsim_run*.log
sim/**/xsim.dir/
sim/**/.shim

# findings/: generated test data and bench outputs; the scripts, sources and notes stay visible
findings/**/build/
findings/**/runs/
findings/**/snap-*/
findings/ap040-pipelined/tests/cputest/data040/
findings/ap040-pipelined/tests/cputest/gen/build/
findings/**/fw-ba-sweep/*.bin
findings/**/obj_*/
findings/ap040-pipelined/tests/kick/patched*
findings/ap040-pipelined/tests/kick/build_pipeboard-*
findings/**/build_*.log
findings/**/*.hdf
findings/**/*.adf
findings/**/*_trace.txt
findings/**/*.log
findings/**/*.pdf
findings/**/*.PDF
findings/ap040-pipelined/tests/cputest/gen/cputestgen
findings/**/.tinfo/

# Vivado build logs next to the build dirs (build_<stage>.log)
/build_*.log
