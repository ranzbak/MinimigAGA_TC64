+// ---- IOPOLL: Minimig-shaped input registers (mouse-button bug, 2026-09-24) ----
+// $BFE001 (CIA-A PRA, odd byte of word $BFE000): bit 6 = /FIR0 (left button)
+// $DFF016 (POTGOR word): bit 10 = DATLY (right button)
+// Both change under the CPU's feet: a free-running toggler, plus a
+// handshake register at $DFF1E0 (word write: bit 0 -> PRA bit 6, bit 1 ->
+// POTGOR bit 10, bit 15 = freeze the free-running toggler).
+reg  [7:0]  io_pra = 8'hFF;
+reg  [15:0] io_pot = 16'hFFFF;
+reg         io_frz = 1'b1;
+integer     io_tick = 0;
+function [15:0] io_rd;
+	input [31:0] a;
+	begin
+		if (a[31:1] == (32'h00BFE000 >> 1))      io_rd = {8'hFF, io_pra};
+		else if (a[31:1] == (32'h00DFF016 >> 1)) io_rd = io_pot;
+		else                                      io_rd = mem[a[15:1]];
+	end
+endfunction
+always @(posedge clk) begin
+	if (nreset && mem_ready && busstate == 2'b11 && addr_out == 32'h00DFF1E0) begin
+		io_pra[6]  <= data_write[0];
+		io_pot[10] <= data_write[1];
+		io_frz     <= data_write[15];
+	end
+	else if (!io_frz) begin
+		io_tick <= io_tick + 1;
+		if (io_tick % 37 == 0) io_pra[6]  <= ~io_pra[6];
+		if (io_tick % 53 == 0) io_pot[10] <= ~io_pot[10];
+	end
+end
+assign data_in = (phase == 2 && lvl_hold) ? lvl_data : io_rd(addr_out);
